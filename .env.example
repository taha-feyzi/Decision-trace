# Optional overrides, only needed if you want to point this at a different
# OpenAI-compatible provider (OpenAI, OpenRouter, etc).
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

DATABASE_URL=
